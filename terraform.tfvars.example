# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize for your environment

# S3 Bucket Configuration
bucket_name = "my-org-server-logs-bucket-unique-name"
aws_region  = "us-east-1"

# Log Retention Configuration (365 days = 1 year for compliance)
retention_days = 365

# Cost Optimization - Storage Class Transitions
transition_to_ia_days      = 90   # Move to Infrequent Access after 90 days
transition_to_glacier_days = 180  # Move to Glacier after 180 days

# Security Configuration
enable_versioning = true
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012" # Optional: Use KMS for encryption

# Tagging for Compliance and Cost Tracking
tags = {
  Environment  = "production"
  Purpose      = "log-retention"
  Compliance   = "1-year-retention"
  ManagedBy    = "terraform"
  CostCenter   = "operations"
  DataClass    = "confidential"
  Owner        = "platform-team"
}
